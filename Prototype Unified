                        <button type="button" onClick={() => setIsCasting(false)} className="flex-1 py-3 bg-slate-200 text-slate-700 rounded-xl font-bold hover:bg-slate-300 transition-colors">Cancel</button>
                        <button type="submit" disabled={!castCandidate} className="flex-2 w-2/3 py-3 bg-emerald-600 text-white rounded-xl font-bold shadow-lg hover:bg-emerald-500 flex justify-center items-center disabled:opacity-50 cursor-pointer transition-colors">
                          <LockIcon size={18} className="mr-2"/> Sign (ML-DSA) & Execute
                        </button>
                      </div>
                    </form>
                  </div>
                )}

                {castStep === 1 && (
                  <div className="bg-slate-900 p-10 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-700 text-center animate-in zoom-in-95 text-white">
                     <div className="relative w-24 h-24 mx-auto mb-6">
                       <RefreshCcwIcon size={48} className="absolute inset-0 m-auto text-purple-500 animate-spin" />
                       <EyeOffIcon size={24} className="absolute inset-0 m-auto text-white z-10" />
                     </div>
                     <h3 className="text-xl font-black mb-2 uppercase tracking-widest text-purple-400">Applying Secret Ballot</h3>
                     <p className="text-[10px] text-slate-400 font-mono mt-4 leading-relaxed">
                       Executing Zero-Knowledge Mixnet.<br/>
                       <span className="text-emerald-400 font-bold">Dynamic Decoy Scaling Active.</span><br/>
                       Ring size optimized for current polling volume. Severing origin wallet link...
                     </p>
                  </div>
                )}

                {castStep === 2 && (
                  <div className="bg-slate-900 p-10 rounded-2xl shadow-2xl w-full max-w-sm border border-slate-700 text-center animate-in zoom-in-95 text-white">
                     <div className="w-24 h-24 mx-auto mb-6 relative">
                       <div className="absolute inset-0 bg-indigo-900/50 rounded-full flex items-center justify-center border-4 border-indigo-500">
                         <EnvelopeIcon size={40} className="text-indigo-400" />
                       </div>
                       <div className="absolute -bottom-2 -right-2 bg-amber-500/20 p-2 rounded-full border border-amber-500 backdrop-blur-sm animate-bounce">
                         <KeyIcon size={16} className="text-amber-400" />
                       </div>
                     </div>
                     <h3 className="text-xl font-black mb-2 uppercase tracking-widest text-indigo-400">Sealing Envelope</h3>
                     <p className="text-[10px] text-slate-400 font-mono mt-4 leading-relaxed">
                       Encrypting payload to Sharded District Mempool.<br/>Applying temporal lock (20:00:00 LOC)...<br/><br/>
                       <span className="text-amber-400 font-bold">Emitting Decoupled Bearer Key (DBK) & Destroying Ephemeral Wallet...</span>
                     </p>
                  </div>
                )}

              </div>
            )}
          </div>
        )}
      </div>
    );
  };

  const root = ReactDOM.createRoot(document.getElementById('root'));
  root.render(<App />);
  </script>
</body>
